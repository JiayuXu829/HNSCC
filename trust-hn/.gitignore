# Private/institutional patient-level data
/data/private/*
!/data/private/.gitkeep

# Immutable/public source data and derived patient-level data
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Results that may contain patient-level predictions
/results/predictions/*
!/results/predictions/.gitkeep
/results/metrics/runs/*
/results/manifests/runs/*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Local caches and credentials
.cache/
.env
*.token
*.secret

# Notebook and OS noise
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# LaTeX build products
/paper/build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
.runtime/
tools/*.exe

.codex/
